{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-riscv-sim",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "simulator/*.cpp",
                "simulator/src/*.cpp",
                "-I", "simulator/include",
                "-o", "simulator/simulator.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
